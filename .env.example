# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_PROFILE_MODEL=gpt-4o

# Project Configuration
PROJECTS_FOLDER=C:\Users\alexl\Desktop\xttribute\Librarian\Projects
PROJECTS_FOLDER_EXCLUDE=Public Projects
VECTOR_DB_PATH=./vector_db
METADATA_DB_PATH=./metadata_db.json

# Cloud Storage Configuration
USE_CLOUD_STORAGE=false
GCS_BUCKET_PDFS=your-pdfs-bucket-name
GCS_BUCKET_VECTORS=your-vectors-bucket-name
GCP_PROJECT_ID=your-gcp-project-id

# Firestore Configuration
USE_FIRESTORE=false
FIRESTORE_COLLECTION=projects_metadata

# Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_PAGES_PER_PDF=500
